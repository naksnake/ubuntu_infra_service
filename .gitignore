# OS
.DS_Store
Thumbs.db

# Python/venv
__pycache__/
*.pyc

# Docker artifacts
*.log

# IDE
.vscode/
.idea/

# Local runtime configuration
.env

# Persistent runtime data (bind mounts — never commit)
data/webfs_share/

# TLS certificates + private keys for the optional HTTPS listener (secrets)
data/certs/

# webfs htdocs subdirs are bind-mount targets: keep the dirs, never their
# contents (boot assets can be large; at runtime they're shadowed by mounts)
services/webfs/htdocs/linux/*
services/webfs/htdocs/ipxe/*
services/webfs/htdocs/files/*
!services/webfs/htdocs/linux/.gitkeep
!services/webfs/htdocs/ipxe/.gitkeep
!services/webfs/htdocs/files/.gitkeep

# DHCP lease database (runtime data)
data/dnsmasq.leases

# iPXE Manager state (runtime data)
data/ipxe_manager/
*efi
*kpxe
# Cluster Control Panel state: SQLite db, job logs, uploads, SSH key (secrets)
data/ccp/

