# ==== Network settings ====
PXE_IFACE=eth1
WAN_IFACE=eth0
PXE_RANGE_START=192.168.100.10
PXE_RANGE_END=192.168.100.200
PXE_NETMASK=255.255.255.0
# How long a client may keep its IP before it must renew (dnsmasq formats:
# 45m, 12h, 1d, infinite; minimum 2m). Clients that stay online renew
# automatically at half the lease time and keep the same IP indefinitely.
PXE_LEASE_TIME=12h
# Fixed IP-to-MAC reservations live in services/dhcp/static-hosts.conf.
PXE_ROUTER_IP=192.168.100.1
WEBFS_HOST_IP=192.168.100.1
TFTP_SERVER_IP=192.168.100.1
DNS_SERVER=8.8.8.8

# ==== Ports ====
WEBFS_PORT=8080
WEBFS_HTTPS_PORT=8443
IPXE_MANAGER_PORT=8091
CCP_PORT=8060
MONITOR_PORT=8090
MONITOR_REFRESH=30

# ==== Web UI exposure (security) ====
# Host address the web UIs (webfs, iPXE Manager, Monitor, CCP) are published
# on. The default 0.0.0.0 exposes them on EVERY interface, including the WAN
# side — anyone on that network can reach the login pages, and an
# iPXE Manager without IPXE_MANAGER_PASSWORD would let them edit what your
# lab machines boot. Set this to the lab IP (same as PXE_ROUTER_IP) so the
# UIs are reachable only from the lab segment and the server itself; from
# elsewhere, tunnel in with: ssh -L 8091:192.168.100.1:8091 <server>
UI_BIND=0.0.0.0

# ==== Optional HTTPS listener for the file share ====
# Set COMPOSE_PROFILES=https to also serve the file share over TLS on
# WEBFS_HTTPS_PORT. deploy.sh generates a self-signed certificate into
# data/certs/webfs.pem on the next run (or place your own chained PEM there:
# certificate first, then private key). PXE clients keep using plain HTTP.
COMPOSE_PROFILES=

# ==== iPXE Manager ====
# Admin account for the web UI and API (HTTP Basic login). Setting a password
# enables auth; leave it blank to disable. /menu.ipxe and the autoinstall
# seeds always stay open for PXE clients.
IPXE_MANAGER_USER=admin
IPXE_MANAGER_PASSWORD=

# ==== Cluster Control Panel (CCP) ====
# Web UI to run ClusterShell commands and Ansible playbooks across your nodes.
CCP_ADMIN_USER=admin
CCP_ADMIN_PASSWORD=changeme
# Set to 1 to seed a self-contained "localhost" demo node + sample scripts on
# first run, so you can try the panel before adding real SSH hosts.
CCP_DEMO=0
# CCP_SECRET_KEY (Flask session signing) is generated by deploy.sh on first run.
# Do NOT set it manually unless restoring from backup.
CCP_SECRET_KEY=

# ==== Monitor dashboard (login + RBAC) ====
# The dashboard now requires login. The admin account reuses CCP_ADMIN_USER /
# CCP_ADMIN_PASSWORD above. Optionally add a read-only viewer account (leave the
# password blank to disable it):
MONITOR_VIEWER_USER=viewer
MONITOR_VIEWER_PASSWORD=
MONITOR_SESSION_MINUTES=30       # session lifetime; sliding (resets on activity)
# MONITOR_SECRET_KEY is generated by deploy.sh on first run.
MONITOR_SECRET_KEY=
